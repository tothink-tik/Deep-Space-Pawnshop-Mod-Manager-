<Application x:Class="Dangpu.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dangpu"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Colors.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <local:CountToVisibilityConverter x:Key="CountToVis" />
            <local:StringToVisibilityConverter x:Key="TextToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
