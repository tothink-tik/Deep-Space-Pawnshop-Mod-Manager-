<Window x:Class="Dangpu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Dangpu.Services"
        Title="深空当铺mod局外管理"
        Width="1240" Height="800" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="Assets/app.ico"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" DragLeave="Window_DragLeave">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- 自定义背景层 -->
            <Border Grid.RowSpan="3" Background="{DynamicResource BgBrush}" />
            <Image Grid.RowSpan="3" Source="{Binding BackgroundImage}" Stretch="UniformToFill" IsHitTestVisible="False"
                   Visibility="{Binding HasBackground, Converter={StaticResource BoolToVis}}">
                <Image.Effect>
                    <BlurEffect Radius="{Binding BackgroundBlur}" />
                </Image.Effect>
            </Image>
            <Border Grid.RowSpan="3" Background="{DynamicResource BgBrush}" Opacity="{Binding BackgroundDim}"
                    IsHitTestVisible="False"
                    Visibility="{Binding HasBackground, Converter={StaticResource BoolToVis}}" />

            <!-- 标题栏 -->
            <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Path Data="F0 M3 3 H21 V21 H3 Z M12 7 L17 12 L12 17 L7 12 Z"
                              Fill="{DynamicResource AccentBrush}" Width="26" Height="26"
                              Stretch="Uniform" />
                        <TextBlock Text="深空当铺mod局外管理" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="1.1 测试版" FontSize="10" Foreground="{DynamicResource AccentBrush}"
                                   Margin="8,1,0,0" VerticalAlignment="Center" />

                        <TextBlock Text="Probably Stolen · 本地模组管理器" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource SuccessBrush}"
                                 Margin="16,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding Source={x:Static svc:ThemeMetrics.Current}, Path=HudVisibility}" />
                        <TextBlock Text="SYS.ONLINE // PS-046" FontFamily="{StaticResource MonoFont}"
                                   FontSize="9.5" Foreground="{DynamicResource TextFaintBrush}"
                                   Margin="7,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding Source={x:Static svc:ThemeMetrics.Current}, Path=HudVisibility}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource ChromeBtn}" Width="36" Click="MusicToggle_Click" ToolTip="背景音乐"
                                Visibility="{Binding HasMusic, Converter={StaticResource BoolToVis}}">
                            <Grid Width="18" Height="16">
                                <Path Data="M3 6 H7 L11 2 V14 L7 10 H3 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" StrokeLineJoin="Round" />
                                <Ellipse Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Fill="{DynamicResource SuccessBrush}"
                                         Visibility="{Binding IsMusicPlaying, Converter={StaticResource BoolToVis}}" />
                                <Ellipse Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Fill="{DynamicResource TextFaintBrush}"
                                         Visibility="{Binding IsMusicPlaying, Converter={StaticResource InverseBoolToVis}}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ChromeBtn}" Click="Minimize_Click" ToolTip="最小化">
                            <Path Data="M1 6 H13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" Width="13" Height="7" Stretch="None" />
                        </Button>
                        <Button x:Name="MaxButton" Style="{StaticResource ChromeBtn}" Click="Maximize_Click" ToolTip="最大化">
                            <Grid Width="14" Height="14">
                                <Path x:Name="MaxIcon" Data="M1.5 1.5 H12.5 V12.5 H1.5 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2" />
                                <Path x:Name="RestoreIcon" Data="M1.5 4.5 H9.5 V12.5 H1.5 Z M4.5 4.5 V1.5 H12.5 V9.5 H9.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.2" Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ChromeCloseBtn}" Click="Close_Click" ToolTip="关闭">
                            <Path Data="M1 1 L12 12 M12 1 L1 12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" Width="12" Height="12" Stretch="None" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主体 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧导航 -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="8,14,8,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="NavList" Grid.Row="0" Style="{StaticResource BareList}"
                                 ItemsSource="{Binding NavItems}"
                                 SelectedIndex="{Binding PageIndex, Mode=TwoWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}" />
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{Binding Icon}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" Width="18" Height="18" Stretch="Uniform"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" Margin="11,0,0,0" FontSize="13"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="2"
                                    Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="游戏目录" Style="{StaticResource H3}" />
                                    <TextBlock Text="{Binding GamePathText}" Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding GamePathText}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource BtnPrimary}" Height="42" Click="Launch_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M1 1 L12 7 L1 13 Z" Fill="{DynamicResource AccentForegroundBrush}" Width="11" Height="11"
                                          Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="启动游戏" Margin="8,0,0,0" FontSize="13.5" />
                                </StackPanel>
                            </Button>

                            <StackPanel Orientation="Horizontal" Margin="3,9,0,0">
                                <Ellipse Width="6" Height="6" Fill="{Binding GameStateBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GameStateText}" Style="{StaticResource Caption}"
                                           Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 页面 -->
                <ContentControl x:Name="PageHost" Grid.Column="1" Margin="24,20,24,16" />
            </Grid>

            <!-- 拖放提示层 -->
            <Grid x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="60"
                  Visibility="Collapsed" Background="#CC0A1211" IsHitTestVisible="False">
                <Grid Width="540" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="DropScale" ScaleX="0.97" ScaleY="0.97" />
                    </Grid.RenderTransform>
                    <Rectangle RadiusX="2" RadiusY="2" Fill="{DynamicResource SurfaceAltBrush}"
                               Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="5 4" />
                    <StackPanel VerticalAlignment="Center">
                        <Border Width="54" Height="54" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                HorizontalAlignment="Center">
                            <Path Data="M12 4 V19 M6 13 L12 19 L18 13 M5 22 H19"
                                  Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="2"
                                  Width="22" Height="22" Stretch="Uniform"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="松手，装进 Mods" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                        <TextBlock Text="dll、zip 或整个文件夹都行，装完直接出现在列表里"
                                   Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,7,0,0" />
                        <TextBlock x:Name="DropInfo" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="18,14,18,0"
                                   TextTrimming="CharacterEllipsis" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 状态栏 -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                   Foreground="{DynamicResource TextSubBrush}" Margin="7,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GameVersionText}" FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}" Margin="8,0" />
                        <TextBlock Text="{Binding LoaderText}" FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}" Margin="8,0" />
                        <TextBlock Text="{Binding CountSummary}" FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
