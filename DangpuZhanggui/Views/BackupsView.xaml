<UserControl x:Class="Dangpu.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="备份" Style="{StaticResource H1}" />
                <TextBlock Text="把 Mods 文件夹和 MelonPreferences.cfg 打成 zip，装新模组之前先留一份。"
                           Style="{StaticResource Caption}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource BtnGhost}" Height="34" Click="OpenFolder_Click">
                    <TextBlock Text="打开备份目录" FontSize="12.5" />
                </Button>
                <Button Style="{StaticResource BtnGhost}" Height="34" Margin="8,0,0,0" Click="Refresh_Click">
                    <TextBlock Text="刷新" FontSize="12.5" />
                </Button>
                <Button Style="{StaticResource BtnPrimary}" Height="34" Margin="8,0,0,0" Click="Create_Click">
                    <TextBlock Text="创建备份" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Background="{DynamicResource SurfaceAltBrush}" Padding="16,12"
                Margin="0,16,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="还原是覆盖式的：备份里的文件会盖掉同名的，备份里没有的模组不会被删掉。每次还原前会自动先存一份当前状态。"
                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,10">
            <Grid>
                <ListBox Style="{StaticResource BareList}" ItemsSource="{Binding Backups}" Padding="4,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" CornerRadius="8" Background="Transparent" Padding="12,11"
                                                Margin="0,0,0,2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background"
                                                        Value="{DynamicResource SurfaceAltBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <Path Data="M3.4 7.6 L12 3.4 L20.6 7.6 L12 11.8 Z M3.4 7.6 V16.4 L12 20.6 V11.8 M20.6 7.6 V16.4 L12 20.6"
                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" Width="16"
                                          Height="16" Stretch="Uniform" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" ToolTip="{Binding Name}" />
                                        <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="4" Padding="6,1"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding Label, Converter={StaticResource TextToVis}}">
                                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource TextSubBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding CreatedText}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="·" Style="{StaticResource Caption}" Margin="7,0" />
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BtnGhost}" Height="30" Padding="12,0" Content="还原"
                                            Click="Restore_Click" />
                                    <Button Style="{StaticResource BtnDanger}" Height="30" Padding="12,0" Margin="6,0,0,0"
                                            Content="删除" Click="Delete_Click" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BackupCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="还没有备份" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="备份存在工具自己的数据目录里，不占游戏目录。" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <Button Style="{StaticResource BtnPrimary}" Height="34" Margin="0,14,0,0"
                            Content="创建备份" Click="Create_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
