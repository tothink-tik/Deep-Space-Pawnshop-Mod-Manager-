<UserControl x:Class="Dangpu.Views.DiagnosisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="诊断" Style="{StaticResource H1}" />
                <TextBlock Text="只读 Latest.log 和模组元数据，把可能的原因、证据和可疑模组摆出来，不改任何文件。"
                           Style="{StaticResource Caption}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource BtnGhost}" Height="34" Click="OpenLog_Click">
                    <TextBlock Text="看日志" FontSize="12.5" />
                </Button>
                <Button Style="{StaticResource BtnGhost}" Height="34" Margin="8,0,0,0" Click="Refresh_Click">
                    <TextBlock Text="重新分析" FontSize="12.5" />
                </Button>
                <Button Style="{StaticResource BtnPrimary}" Height="34" Margin="8,0,0,0" Click="SafeLaunch_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M1 1 L12 7 L1 13 Z" Fill="{DynamicResource AccentForegroundBrush}"
                              Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="纯净启动" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,13" Margin="0,16,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="4" Padding="8,2">
                        <TextBlock FontSize="11" Foreground="{DynamicResource DangerBrush}">
                            <Run Text="错误 " /><Run Text="{Binding CriticalCount, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="4" Padding="8,2" Margin="6,0,0,0">
                        <TextBlock FontSize="11" Foreground="{DynamicResource WarnBrush}">
                            <Run Text="警告 " /><Run Text="{Binding WarningCount, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding DiagnosisVerdict}" FontSize="12"
                               Foreground="{DynamicResource TextSubBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="基于 MelonLoader/Latest.log" Style="{StaticResource Caption}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,10">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,0,4,0">
                    <ItemsControl ItemsSource="{Binding Findings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="9"
                                        Margin="0,0,0,8" Padding="0">
                                    <Grid>
                                        <Border Width="3" CornerRadius="2" Background="{Binding Dot}"
                                                HorizontalAlignment="Left" Margin="0,10" />
                                        <StackPanel Margin="16,12,14,12">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           TextWrapping="Wrap" MaxWidth="520" />
                                                <Border Background="{Binding Bg}" CornerRadius="4" Padding="6,1"
                                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LevelText}" FontSize="10"
                                                               Foreground="{Binding Fg}" />
                                                </Border>
                                                <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}"
                                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap"
                                                       LineHeight="18" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Suggestion}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                                       LineHeight="18" Margin="0,4,0,0" />

                                            <ItemsControl ItemsSource="{Binding Suspects}" Margin="0,8,0,0"
                                                          Visibility="{Binding HasSuspects, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource BtnSubtle}" Height="24" Padding="8,0"
                                                                Margin="0,0,6,0" Tag="{Binding}" Click="Suspect_Click"
                                                                ToolTip="在模组页定位这个模组">
                                                            <TextBlock Text="{Binding}" FontSize="11"
                                                                       Foreground="{DynamicResource AccentBrush}" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding Evidence}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,8,0,0"
                                                       ToolTip="{Binding Evidence}"
                                                       Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasFindings, Converter={StaticResource InverseBoolToVis}}">
                    <Border Width="54" Height="54" CornerRadius="27" Background="{DynamicResource SuccessSoftBrush}"
                            HorizontalAlignment="Center">
                        <Path Data="M2,6 L5,9 L10,2" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2"
                              Width="22" Height="20" Stretch="Uniform" HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="没发现明显问题" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <TextBlock Text="先启动一次游戏，让 Latest.log 有内容，再回来看。"
                               Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
