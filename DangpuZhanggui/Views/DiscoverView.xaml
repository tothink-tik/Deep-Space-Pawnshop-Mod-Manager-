<UserControl x:Class="Dangpu.Views.DiscoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="SearchCard" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource SurfaceBrush}" CornerRadius="2"
                                BorderThickness="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="发现" Style="{StaticResource H1}" />
                <TextBlock Text="用 Nexus 官方 API 搜这个游戏的模组。能看封面、作者、版本和下载量；装还是走模组页面。"
                           Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="NEXUS // EXTERNAL" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                           Foreground="{DynamicResource NeonBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Style="{StaticResource BtnGhost}" Height="34" Click="OpenNexus_Click">
                    <TextBlock Text="打开 N 网页面 ↗" FontSize="12.5" Foreground="{DynamicResource NeonBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0,16,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Style="{StaticResource SearchStyle}" Width="Auto" Height="36"
                         Tag="搜 N 网：英文关键词更好找，比如 trade、ratlin"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="Search_KeyDown" />

                <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Height="36" Margin="8,0,0,0"
                        Click="Search_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M10.5 4 A6.5 6.5 0 1 1 10.45 4 M15.2 15.2 L20.5 20.5"
                              Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.6"
                              Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="搜索" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Height="36" Margin="8,0,0,0"
                        Content="{Binding SearchSortButtonText}" FontSize="12" Click="Sort_Click"
                        ToolTip="点击切换排序：相关度 / 下载 / 点赞 / 更新" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,10">
                    <TextBlock Text="{Binding SearchTotalText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <TextBlock Text="搜索走官方 API，不会自动下载文件" Style="{StaticResource Caption}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding ShowSearchResults, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SearchCard}" Width="344" Margin="0,0,10,10"
                                            Tag="{Binding}" Click="OpenResult_Click" ToolTip="打开 N 网模组页面">
                                        <StackPanel>
                                            <Border Height="132" Background="{DynamicResource SurfaceBrush}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" FontSize="30" FontWeight="SemiBold"
                                                               Foreground="#55EAE5D7" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Margin="13,11,13,13">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Author}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Summary}" FontSize="11.5"
                                                           Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,7,0,0" />
                                                <Grid Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource Caption}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource Caption}"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource BtnGhost}" Height="34" Margin="0,4,0,8"
                                Content="加载更多" Click="LoadMore_Click"
                                Visibility="{Binding HasMoreSearchResults, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 初始 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding ShowSearchIdle, Converter={StaticResource BoolToVis}}">
                    <Border Width="54" Height="54" CornerRadius="27" Background="{DynamicResource AccentSoftBrush}"
                            HorizontalAlignment="Center">
                        <Path Data="M10.5 4 A6.5 6.5 0 1 1 10.45 4 M15.2 15.2 L20.5 20.5"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" Width="20" Height="20"
                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="搜一搜 N 网上的模组" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="输入关键词后回车；英文名通常比中文好搜。" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Style="{StaticResource BtnSubtle}" Height="26" Padding="8,0" Margin="0,0,4,0"
                                Content="trade" Tag="trade" Click="Suggestion_Click" />
                        <Button Style="{StaticResource BtnSubtle}" Height="26" Padding="8,0" Margin="4,0"
                                Content="ratlin" Tag="ratlin" Click="Suggestion_Click" />
                        <Button Style="{StaticResource BtnSubtle}" Height="26" Padding="8,0" Margin="4,0,0,0"
                                Content="workshop" Tag="workshop" Click="Suggestion_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- 没有 key -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding ShowSearchNoKey, Converter={StaticResource BoolToVis}}">
                    <Border Width="54" Height="54" CornerRadius="27" Background="{DynamicResource WarnSoftBrush}"
                            HorizontalAlignment="Center">
                        <Path Data="M6 10 V7 A4 4 0 0 1 14 7 V10 M5 10 H15 V20 H5 Z"
                              Stroke="{DynamicResource WarnBrush}" StrokeThickness="1.6" Width="18" Height="18"
                              Stretch="Uniform" StrokeLineJoin="Round" HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="需要 Nexus API key" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="填一次就能在这个页面直接搜；key 只存在本机。" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <Button Style="{StaticResource BtnPrimary}" Height="34" Margin="0,12,0,0"
                            Content="去设置填 key" Click="OpenKeySettings_Click" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 没结果 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding ShowSearchEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="没搜到" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="换个英文关键词试试，或者把排序切到「下载最多」看看热门。" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>

                <!-- 出错 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding ShowSearchError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SearchErrorText}" FontSize="12" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center" />
                    <Button Style="{StaticResource BtnGhost}" Height="30" Margin="0,10,0,0" Content="重试"
                            HorizontalAlignment="Center" Click="Search_Click" />
                </StackPanel>

                <!-- 加载中 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding ShowSearchLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="正在搜索 N 网…" FontSize="13" Foreground="{DynamicResource TextSubBrush}"
                               HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Width="160" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
