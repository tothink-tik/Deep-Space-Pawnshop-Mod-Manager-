<UserControl x:Class="Dangpu.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="运行日志" Style="{StaticResource H1}" />
                <TextBlock Text="MelonLoader/Latest.log。哪个模组真被加载了、哪个被静默丢掉，这里最诚实。"
                           Style="{StaticResource Caption}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBox Style="{StaticResource SearchStyle}" Width="180" Margin="0,0,12,0"
                         Tag="搜索日志" Text="{Binding LogSearch, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="只看问题" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    <ToggleButton Style="{StaticResource Switch}" Margin="8,0,0,0"
                                  IsChecked="{Binding LogOnlyProblems, Mode=TwoWay}" />
                </StackPanel>
                <Button Style="{StaticResource BtnGhost}" Height="34" Click="OpenFolder_Click">
                    <TextBlock Text="打开日志文件夹" FontSize="12.5" />
                </Button>
                <Button Style="{StaticResource BtnGhost}" Height="34" Margin="8,0,0,0" Click="Export_Click">
                    <TextBlock Text="导出" FontSize="12.5" />
                </Button>
                <Button Style="{StaticResource BtnPrimary}" Height="34" Margin="8,0,0,0" Click="Refresh_Click">
                    <TextBlock Text="刷新" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,13" Margin="0,16,0,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="本次启动" Style="{StaticResource H3}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="4" Padding="7,2" Margin="10,0,0,0">
                        <TextBlock FontSize="10.5" Foreground="{DynamicResource SuccessBrush}">
                            <Run Text="加载 " /><Run Text="{Binding Log.LoadedDlls.Count, Mode=OneWay}" /><Run Text=" 个" />
                        </TextBlock>
                    </Border>
                    <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="4" Padding="7,2" Margin="6,0,0,0">
                        <TextBlock FontSize="10.5" Foreground="{DynamicResource DangerBrush}">
                            <Run Text="错误 " /><Run Text="{Binding Log.ErrorCount, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="4" Padding="7,2" Margin="6,0,0,0">
                        <TextBlock FontSize="10.5" Foreground="{DynamicResource WarnBrush}">
                            <Run Text="警告 " /><Run Text="{Binding Log.WarnCount, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding LogHeaderText}" Style="{StaticResource Caption}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6,8,6,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="10,0,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="时间" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Grid.Column="1" Text="内容" FontSize="10.5"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Grid>

                <ListBox Grid.Row="1" Style="{StaticResource BareList}" ItemsSource="{Binding LogView}"
                         Focusable="False" ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Bg}" CornerRadius="4" Padding="10,4" Margin="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                               Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="11" Foreground="{Binding Fg}" TextWrapping="Wrap"
                                               LineHeight="17" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLog}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="还没有日志" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="启动一次游戏，MelonLoader 就会写出 Latest.log。" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
