<Window x:Class="Dangpu.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource TextBrush}">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="12" Padding="20">
        <StackPanel>
            <StackPanel Orientation="Horizontal" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border x:Name="IconBorder" Width="34" Height="34" CornerRadius="17"
                        Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                    <TextBlock x:Name="IconGlyph" Text="!" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" Text="提示" FontSize="15" FontWeight="SemiBold"
                           Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330" />
            </StackPanel>

            <TextBlock x:Name="MessageText" FontSize="12" Foreground="{DynamicResource TextSubBrush}"
                       TextWrapping="Wrap" LineHeight="20" Margin="0,14,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource BtnGhost}" Height="32" MinWidth="80"
                        Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="NoButton" Style="{StaticResource BtnGhost}" Height="32" MinWidth="80"
                        Margin="0,0,8,0" Click="No_Click" />
                <Button x:Name="YesButton" Style="{StaticResource BtnPrimary}" Height="32" MinWidth="88"
                        Click="Yes_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
