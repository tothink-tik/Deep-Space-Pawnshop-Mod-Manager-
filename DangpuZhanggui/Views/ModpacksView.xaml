<UserControl x:Class="Dangpu.Views.ModpacksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Text="整合包" Style="{StaticResource H1}" />
                    <TextBlock Text="把当前启用的模组和配置打成一个包，别人导入后直接安装。"
                               Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource BtnGhost}" Height="34" Content="导入整合包" Click="Import_Click" />
                    <Button Style="{StaticResource BtnGhost}" Height="34" Margin="8,0,0,0" Content="打开整合包文件夹"
                            Click="OpenFolder_Click" />
                </StackPanel>
            </Grid>

            <!-- 制作 -->
            <Border Style="{StaticResource Card}" Padding="22,20" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="制作整合包" Style="{StaticResource H2}" />
                    <TextBlock Text="只打包当前已启用的模组。安装时会先自动备份对方的 Mods 和 MelonPreferences.cfg，再替换。"
                               Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="名称" Style="{StaticResource Caption}" />
                            <TextBox Style="{StaticResource FieldStyle}" Margin="0,5,0,12"
                                     Text="{Binding PackName, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="版本" Style="{StaticResource Caption}" />
                                    <TextBox Style="{StaticResource FieldStyle}" Margin="0,5,0,0"
                                             Text="{Binding PackVersion, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="作者" Style="{StaticResource Caption}" />
                                    <TextBox Style="{StaticResource FieldStyle}" Margin="0,5,0,0"
                                             Text="{Binding PackAuthor, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="说明" Style="{StaticResource Caption}" Margin="0,14,0,0" />
                            <TextBox Style="{StaticResource FieldStyle}" Height="74" Margin="0,5,0,0"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     Padding="10,8" Text="{Binding PackDescription, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="2" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="{Binding PackSourceText}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="模组会按当前启用状态打包；文件夹模组会整个带进去。"
                                           Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="包含 MelonPreferences.cfg" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ToggleButton Style="{StaticResource Switch}"
                                                  IsChecked="{Binding PackIncludeConfig, Mode=TwoWay}" />
                                </StackPanel>
                                <Button Style="{StaticResource BtnPrimary}" Height="36" Margin="0,18,0,0"
                                        Content="生成整合包" Click="Create_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 本地整合包 -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource SurfaceAltBrush}" Padding="10">
                        <Grid>
                            <ListBox Style="{StaticResource BareList}" ItemsSource="{Binding Modpacks}"
                                     SelectedItem="{Binding SelectedModpack, Mode=TwoWay}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainRow}">
                                        <Setter Property="Height" Value="58" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="还没有整合包" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasModpacks, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" Margin="22,18,22,18">
                        <StackPanel Visibility="{Binding HasSelectedModpack, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectedModpack.Name}" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedModpack.Subtitle}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SelectedModpack.GameLine}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            <TextBlock Text="模组" Style="{StaticResource H3}" Margin="0,12,0,4" />

                            <ScrollViewer MaxHeight="116" VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
                                <ItemsControl ItemsSource="{Binding SelectedModpack.Manifest.Mods}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                           Foreground="{DynamicResource TextSubBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,64,0" />
                                                <TextBlock Text="{Binding Version}" Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="{Binding SelectedModpack.SizeText}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding SelectedModpack.CreatedText}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <TextBlock Text="安装会先自动备份当前的 Mods 和配置，然后清空 Mods 并替换。游戏必须先关闭。"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource BtnPrimary}" Height="34" Content="安装到游戏"
                                        Click="Install_Click" />
                                <Button Style="{StaticResource BtnGhost}" Height="34" Margin="8,0,0,0"
                                        Content="打开文件位置" Click="OpenFile_Click" />
                                <Button Style="{StaticResource BtnDanger}" Height="34" Margin="8,0,0,0"
                                        Content="删除" Click="Delete_Click" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding HasSelectedModpack, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="选择一个整合包" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="左边列表里点一个，或者先在上面生成/导入。" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
