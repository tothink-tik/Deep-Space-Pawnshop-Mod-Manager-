<UserControl x:Class="Dangpu.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="模组管理" Style="{StaticResource H1}" />
                <TextBlock Text="Mods 文件夹里的东西都在这。勾选就是启用/停用，把 dll、zip 或整个文件夹拖进窗口就是安装。"
                           Style="{StaticResource Caption}" Margin="0,5,40,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchStyle}" Tag="搜索模组"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Style="{StaticResource BtnPrimary}" Height="34" Margin="8,0,0,0" Click="Install_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M8 1 V13 M2 7 H14" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.6"
                              Width="12" Height="12" Stretch="Uniform" StrokeStartLineCap="Round"
                              VerticalAlignment="Center" />
                        <TextBlock Text="安装模组" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 筛选与工具 -->
        <Grid Grid.Row="1" Margin="0,15,0,11">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="ChipAll" Style="{StaticResource Chip}" Tag="All" Click="Filter_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="全部" FontSize="12" />
                        <TextBlock Text="{Binding ModCount}" FontSize="12" Margin="6,0,0,0" Opacity="0.6" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ChipEnabled" Style="{StaticResource Chip}" Tag="Enabled" Margin="6,0,0,0"
                              Click="Filter_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="已启用" FontSize="12" />
                        <TextBlock Text="{Binding EnabledCount}" FontSize="12" Margin="6,0,0,0" Opacity="0.6" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ChipDisabled" Style="{StaticResource Chip}" Tag="Disabled" Margin="6,0,0,0"
                              Click="Filter_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="已停用" FontSize="12" />
                        <TextBlock Text="{Binding DisabledCount}" FontSize="12" Margin="6,0,0,0" Opacity="0.6" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ChipProblem" Style="{StaticResource Chip}" Tag="Problem" Margin="6,0,0,0"
                              Click="Filter_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="有问题" FontSize="12" />
                        <TextBlock Text="{Binding ProblemCount}" FontSize="12" Margin="6,0,0,0" Opacity="0.6" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding FilteredCount}" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="个" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <Button Style="{StaticResource BtnGhost}" Height="30" Padding="10,0" Margin="10,0,0,0"
                        Click="ImportFolder_Click" ToolTip="选择一个文件夹，递归导入里面的 dll 和 zip">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M3.5 6.6 H9.2 L11.2 8.6 H20.5 V18.6 H3.5 Z M3.5 8.6 H20.5"
                              Stroke="{DynamicResource TextSubBrush}" StrokeThickness="1.3" Width="12" Height="12"
                              Stretch="Uniform" StrokeLineJoin="Round" VerticalAlignment="Center" />
                        <TextBlock Text="导入文件夹" FontSize="12" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnGhost}" Height="30" Padding="10,0" Margin="8,0,0,0"
                        Click="Export_Click" ToolTip="导出 CSV 或 Markdown 详细列表">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M8 2 V12 M4 8.5 L8 12.5 L12 8.5 M3 16 H13"
                              Stroke="{DynamicResource TextSubBrush}" StrokeThickness="1.4" Width="12" Height="12"
                              Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              VerticalAlignment="Center" />
                        <TextBlock Text="导出列表" FontSize="12" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnGhost}" Height="30" Padding="8,0" Margin="8,0,0,0"
                        Click="Batch_Click" ToolTip="批量启用 / 停用">
                    <TextBlock Text="批量" FontSize="12" />
                </Button>
                <Button Style="{StaticResource BtnIcon}" Margin="4,0,0,0" Click="OpenFolder_Click"
                        ToolTip="打开 Mods 文件夹">
                    <Path Data="M3.5 6.6 H9.2 L11.2 8.6 H20.5 V18.6 H3.5 Z M3.5 8.6 H20.5"
                          Stroke="{DynamicResource TextSubBrush}" StrokeThickness="1.3" Width="14" Height="14"
                          Stretch="Uniform" StrokeLineJoin="Round" />
                </Button>
                <Button Style="{StaticResource BtnIcon}" Margin="2,0,0,0" Click="Sort_Click"
                        ToolTip="{Binding SortTooltip}">
                    <Path Data="M4 6 H20 M4 12 H15 M4 18 H10" Stroke="{DynamicResource TextSubBrush}"
                          StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"
                          StrokeStartLineCap="Round" />
                </Button>
                <Button Style="{StaticResource BtnIcon}" Margin="2,0,0,0" Click="CheckUpdates_Click"
                        ToolTip="检查 N 网更新（需要 API key）">
                    <Path Data="M12 19 V6 M6 12 L12 6 L18 12" Stroke="{DynamicResource TextSubBrush}"
                          StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Button Style="{StaticResource BtnIcon}" Margin="2,0,0,0" Click="Refresh_Click" ToolTip="重新扫描">
                    <Path Data="M4 8 A4 4 0 1 1 5.4 11.2 M4 4 V8 H8" Stroke="{DynamicResource TextSubBrush}"
                          StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 列表 + 详情 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="332" />
            </Grid.ColumnDefinitions>

            <Grid>
                <ListBox x:Name="ModList" Style="{StaticResource BareList}"
                         ItemsSource="{Binding ModsView}" SelectedItem="{Binding SelectedMod, Mode=TwoWay}"
                         SelectionChanged="ModList_SelectionChanged"
                         ItemContainerStyle="{StaticResource ModRow}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,10,14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Style="{StaticResource ModCheck}" IsChecked="{Binding Enabled, Mode=OneWay}"
                                          VerticalAlignment="Center" Margin="2,0,12,0" Click="ModCheck_Click"
                                          ToolTip="启用 / 停用" />

                                <Border Grid.Column="1" Width="38" Height="38" CornerRadius="9"
                                        Background="{Binding TileBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="16"
                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="2" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="4"
                                                Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasVersion, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding VersionText}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextSubBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SubLine}" FontSize="11.5"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding Chips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Bg}" CornerRadius="4" Padding="7,2"
                                                        Margin="4,0,0,0" ToolTip="{Binding Tip}">
                                                    <TextBlock Text="{Binding Text}" FontSize="10.5"
                                                               Foreground="{Binding Fg}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 常用状态下的虚线投放区 -->
                <Grid VerticalAlignment="Bottom" Margin="0,0,4,8" Height="64" IsHitTestVisible="False"
                      Visibility="{Binding ShowDropHint, Converter={StaticResource BoolToVis}}">
                    <Rectangle RadiusX="10" RadiusY="10" Stroke="{DynamicResource BorderStrongBrush}"
                               StrokeThickness="1.2" StrokeDashArray="4 3" Fill="#10000000" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M12 4 V19 M6 13 L12 19 L18 13 M5 22 H19"
                              Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6"
                              Width="16" Height="16" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" />
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="把 dll、zip 或文件夹拖到这里" FontSize="12"
                                       Foreground="{DynamicResource TextSubBrush}" />
                            <TextBlock Text="也可以点右上角「安装模组」" FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 筛选无结果 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="没有匹配的模组" FontSize="13.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <Button Style="{StaticResource BtnSubtle}" Height="26" Padding="8,0" Margin="0,6,0,0"
                            HorizontalAlignment="Center" Click="ClearFilters_Click">
                        <TextBlock Text="清除筛选条件" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                    </Button>
                </StackPanel>

                <!-- 空状态：本身也是一块投放区 -->
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="440" Height="180"
                      Visibility="{Binding ModCount, Converter={StaticResource CountToVis}}">
                    <Rectangle RadiusX="12" RadiusY="12" Stroke="{DynamicResource BorderStrongBrush}"
                               StrokeThickness="1.2" StrokeDashArray="5 4" Fill="#10000000" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="54" Height="54" CornerRadius="27" Background="{DynamicResource AccentSoftBrush}"
                                HorizontalAlignment="Center">
                            <Path Data="M12 4 V19 M6 13 L12 19 L18 13 M5 22 H19"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" Width="19" Height="19"
                                  Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="把模组拖到这里" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="dll、zip 或整个文件夹都行，也可以点右上角「安装模组」。"
                                   Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 详情 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                <Grid>
                    <!-- 未选中 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="选一个模组" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="右边这里会显示它的信息、体检结果和操作。"
                                   Style="{StaticResource Caption}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- 选中 -->
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,18,14,0">
                            <StackPanel>
                                <!-- 封面：优先显示 N 网主图，没有就用模组色块 -->
                                <Border Height="150" Margin="0,0,0,14" Background="{DynamicResource SurfaceAltBrush}">
                                    <Grid>
                                        <TextBlock Text="{Binding SelectedMod.Initial}" FontSize="32" FontWeight="SemiBold"
                                                   Foreground="#55EAE5D7" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Source="{Binding SelectedMod.Cover}" Stretch="UniformToFill" />
                                        <Border Background="#CC0B1012"
                                                Visibility="{Binding SelectedMod.CoverLoading, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="正在读取 N 网封面…" FontSize="11.5"
                                                       Foreground="{DynamicResource TextSubBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedMod.DisplayName}" FontSize="15"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedMod.SecondaryName}" Style="{StaticResource Caption}"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding SelectedMod.HasSecondaryName, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="作者" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding SelectedMod.AuthorText}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSubBrush}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="7,2"
                                            Visibility="{Binding SelectedMod.HasVersion, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding SelectedMod.VersionText}" FontSize="10.5"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="4" Padding="7,2"
                                            Margin="6,0,0,0">
                                        <TextBlock Text="{Binding SelectedMod.StateText}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSubBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4" Padding="7,2"
                                            Margin="6,0,0,0"
                                            Visibility="{Binding SelectedMod.HasUpdate, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding SelectedMod.UpdateText}" FontSize="10.5"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </StackPanel>

                                <Border BorderThickness="0" Margin="0,22,0,0" Padding="0">
                                    <StackPanel>
                                        <TextBlock Text="简介" Style="{StaticResource H3}" Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding SelectedMod.DescriptionText}" FontSize="12"
                                                   Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap"
                                                   LineHeight="19" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Style="{StaticResource BtnSubtle}" Height="24" Padding="0"
                                                    Click="ToggleDescription_Click"
                                                    Content="{Binding SelectedMod.DescriptionToggleText}"
                                                    Visibility="{Binding SelectedMod.HasLongDescription, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource BtnSubtle}" Height="24" Padding="0" Margin="12,0,0,0"
                                                    HorizontalAlignment="Left" Click="OpenLink_Click"
                                                    Visibility="{Binding SelectedMod.HasLink, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="打开模组页面 ↗" FontSize="11.5"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Button>
                                        </StackPanel>

                                        <WrapPanel Margin="0,2,0,0">
                                            <Button Content="绑定 N 网页面" Style="{StaticResource BtnSubtle}"
                                                    Height="24" Padding="0" Click="BindNexus_Click"
                                                    Visibility="{Binding SelectedMod.HasLink, Converter={StaticResource InverseBoolToVis}}" />
                                            <Button Content="改绑" Style="{StaticResource BtnSubtle}" Height="24"
                                                    Padding="0" Click="BindNexus_Click"
                                                    Visibility="{Binding SelectedMod.HasLink, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="取消绑定" Style="{StaticResource BtnSubtle}" Height="24"
                                                    Padding="0" Margin="10,0,0,0" Click="UnbindNexus_Click"
                                                    Visibility="{Binding SelectedMod.HasManualLink, Converter={StaticResource BoolToVis}}" />
                                        </WrapPanel>

                                        <TextBlock Text="{Binding SelectedMod.NexusHint}" FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                                   LineHeight="17" Margin="0,8,0,0"
                                                   Visibility="{Binding SelectedMod.HasNexusHint, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="去设置填 Nexus key" Style="{StaticResource BtnGhost}"
                                                Height="28" Padding="10,0" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                FontSize="11.5" Click="OpenNexusSettings_Click"
                                                Visibility="{Binding SelectedMod.NeedsNexusKey, Converter={StaticResource BoolToVis}}" />

                                        <TextBlock Text="资料库里没有收录它的简介。"
                                                   FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding SelectedMod.HasDescription, Converter={StaticResource InverseBoolToVis}}" />
                                    </StackPanel>
                                </Border>

                                <Border BorderThickness="0" Margin="0,22,0,0" Padding="0">
                                    <StackPanel>
                                        <TextBlock Text="文件" Style="{StaticResource H3}" Margin="0,0,0,8" />
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="名称" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedMod.FileName}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" />
                                        </Grid>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="大小" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedMod.SizeText}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextSubBrush}" />
                                        </Grid>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="修改" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedMod.ModifiedText}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextSubBrush}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="程序集" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedMod.AssemblyName}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border BorderThickness="0" Margin="0,22,0,0" Padding="0">
                                    <StackPanel>
                                        <TextBlock Text="体检" Style="{StaticResource H3}" Margin="0,0,0,8" />
                                        <TextBlock Text="没有发现问题。" FontSize="11.5"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Visibility="{Binding SelectedMod.HasIssues, Converter={StaticResource InverseBoolToVis}}" />
                                        <ItemsControl ItemsSource="{Binding SelectedMod.Issues}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="6" Height="6" Fill="{Binding Dot}" Margin="0,5,8,0"
                                                                 VerticalAlignment="Top" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11.5"
                                                                   Foreground="{Binding Fg}" TextWrapping="Wrap"
                                                                   LineHeight="18" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="1" BorderThickness="0"
                                Padding="16,12">
                            <StackPanel>
                                <Button Style="{StaticResource BtnPrimary}" Height="36"
                                        Content="{Binding SelectedMod.ToggleActionText}" Click="Toggle_Click" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource BtnGhost}" Height="32" Content="打开位置"
                                            Margin="0,0,4,0" Click="OpenLocation_Click" />
                                    <Button Grid.Column="1" Style="{StaticResource BtnDanger}" Height="32"
                                            Content="删除" Margin="4,0,0,0" Click="Delete_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
