<UserControl x:Class="Dangpu.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dangpu"
             xmlns:svc="clr-namespace:Dangpu.Services"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        <StackPanel>

            <Grid>
                <StackPanel>
                    <TextBlock Text="概览" Style="{StaticResource H1}" />
                    <TextBlock Text="模组、日志和启动，都在这一张柜台上。"
                               Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource BtnGhost}"
                        Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M4 8 A4 4 0 1 1 5.4 11.2 M4 4 V8 H8" Stroke="{DynamicResource TextSubBrush}"
                              StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                        <TextBlock Text="刷新" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 柜台主区 -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource SurfaceBrush}" Padding="28,24" Margin="0,20,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource TechGridBrush}" Opacity="0.5" IsHitTestVisible="False"
                            Grid.ColumnSpan="2" HorizontalAlignment="Right" Width="380"
                            Visibility="{Binding Source={x:Static svc:ThemeMetrics.Current}, Path=HudVisibility}" />
                    <Border Background="{DynamicResource ScanlineBrush}" Opacity="0.6" IsHitTestVisible="False" Grid.ColumnSpan="2"
                            Visibility="{Binding Source={x:Static svc:ThemeMetrics.Current}, Path=HudVisibility}" />

                    <Path Grid.ColumnSpan="2" Data="M0 12 V0 H12"
                          Visibility="{Binding Source={x:Static svc:ThemeMetrics.Current}, Path=HudVisibility}" Stroke="{DynamicResource TealBrush}" StrokeThickness="1.5"
                          HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" />
                    <Path Grid.ColumnSpan="2" Data="M0 0 H12 V12"
                          Visibility="{Binding Source={x:Static svc:ThemeMetrics.Current}, Path=HudVisibility}" Stroke="{DynamicResource TealBrush}" StrokeThickness="1.5"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" />
                    <Path Grid.ColumnSpan="2" Data="M0 0 V12 H12"
                          Visibility="{Binding Source={x:Static svc:ThemeMetrics.Current}, Path=HudVisibility}" Stroke="{DynamicResource TealBrush}" StrokeThickness="1.5"
                          HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" />
                    <Path Grid.ColumnSpan="2" Data="M12 0 V12 H0"
                          Visibility="{Binding Source={x:Static svc:ThemeMetrics.Current}, Path=HudVisibility}" Stroke="{DynamicResource TealBrush}" StrokeThickness="1.5"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" />

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                    Visibility="{Binding Source={x:Static svc:ThemeMetrics.Current}, Path=HudVisibility}">
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="CABINET // PS-046" FontFamily="{StaticResource MonoFont}"
                                       FontSize="9.5" Foreground="{DynamicResource TextFaintBrush}"
                                       Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Game.NameZh}" FontSize="34" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding GamePathText}" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="{Binding GameVersionText}" FontSize="11.5"
                                       Foreground="{DynamicResource TextSubBrush}" />
                            <TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}" Margin="8,0" />
                            <TextBlock Text="{Binding LoaderText}" FontSize="11.5"
                                       Foreground="{DynamicResource TextSubBrush}" />
                            <TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource TextFaintBrush}" Margin="8,0" />
                            <TextBlock Text="{Binding GameTypeText}" FontSize="11.5"
                                       Foreground="{DynamicResource TextSubBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,0,0">
                        <Button Style="{StaticResource BtnPrimary}" Height="46" Width="156" Click="Launch_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M1 1 L12 7 L1 13 Z" Fill="{DynamicResource AccentForegroundBrush}" Width="12" Height="12"
                                      Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="启动游戏" Margin="8,0,0,0" FontSize="14" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BtnGhost}" Height="34" Width="156" Margin="0,6,0,0"
                                Click="OpenFolder_Click">
                            <TextBlock Text="打开游戏目录" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 一行数字，不做四张卡 -->
            <Border Style="{StaticResource Card}" Background="{DynamicResource SurfaceAltBrush}" Padding="24,18" Margin="0,8,0,0"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding ModCount}" FontSize="30" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="模组总数" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding EnabledOfTotalText}" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding LoadedInLogCount}" FontSize="30" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="本次日志已加载" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding LoaderText}" Style="{StaticResource Caption}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding ProblemCount}" FontSize="30" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="需要留意" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding HealthText}" Style="{StaticResource Caption}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="{Binding BackupCount}" FontSize="30" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="备份" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding LatestBackupText}" Style="{StaticResource Caption}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 体检 + 日志：两块平面，不套卡 -->
            <Grid Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,28,0">
                    <Grid>
                        <TextBlock Text="体检" Style="{StaticResource H2}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding OverviewIssues}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" Fill="{Binding Dot}" Margin="0,5,10,0"
                                             VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding ModName}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="{Binding Text}" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{Binding Fg}" Margin="0,2,0,0" LineHeight="17" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasIssues}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="没有发现明显问题，模组都能被加载器认出来。"
                                   Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Grid>
                        <TextBlock Text="最近日志" Style="{StaticResource H2}" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource BtnSubtle}" Height="24"
                                Padding="6,0" Click="OpenLog_Click">
                            <TextBlock Text="全部" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" />
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding LogSummary}" Style="{StaticResource Caption}" Margin="0,6,0,10"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding RecentLogLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Bg}" CornerRadius="2" Padding="7,4" Margin="0,0,0,2">
                                    <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="10.5" TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding Fg}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="2" Padding="18,12"
                    Margin="0,24,0,0" Visibility="{Binding GameMissing, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="还没有找到游戏目录。到「设置」里指定 Probably Stolen.exe 所在的文件夹，或者点自动检测。"
                               Style="{StaticResource Caption}" Margin="9,0,0,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource BtnGhost}" Height="26" Padding="10,0" Margin="12,0,0,0"
                            Click="Detect_Click">
                        <TextBlock Text="自动检测" FontSize="11.5" />
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
