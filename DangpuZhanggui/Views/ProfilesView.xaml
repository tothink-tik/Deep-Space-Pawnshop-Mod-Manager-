<UserControl x:Class="Dangpu.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="方案" Style="{StaticResource H1}" />
                <TextBlock Text="把当前的启停组合存下来，换配置时一键切回去。只记录开关，不动 Mods 里的文件。"
                           Style="{StaticResource Caption}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource BtnGhost}" Height="34" Click="OpenFolder_Click">
                    <TextBlock Text="打开方案目录" FontSize="12.5" />
                </Button>
                <Button Style="{StaticResource BtnGhost}" Height="34" Margin="8,0,0,0" Click="Refresh_Click">
                    <TextBlock Text="刷新" FontSize="12.5" />
                </Button>
                <Button Style="{StaticResource BtnPrimary}" Height="34" Margin="8,0,0,0" Click="Save_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M6 3.4 H18 V21 L12 16.6 L6 21 Z" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.5"
                              Width="12" Height="12" Stretch="Uniform" StrokeLineJoin="Round"
                              VerticalAlignment="Center" />
                        <TextBlock Text="保存当前配置" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Background="{DynamicResource SurfaceAltBrush}"
                Padding="16,12" Margin="0,16,0,10">
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                       Text="「应用」只调整方案里记录过的模组，后来新装的不会被动；「严格应用」会把方案里没记录的模组也停用，适合在几套干净配置之间切。游戏运行时不让切，避免文件被占用。" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,10">
            <Grid>
                <ListBox Style="{StaticResource BareList}" ItemsSource="{Binding Profiles}" Padding="4,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" CornerRadius="8" Background="Transparent" Padding="12,11"
                                                Margin="0,0,0,2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background"
                                                        Value="{DynamicResource SurfaceAltBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <Path Data="M6 3.4 H18 V21 L12 16.6 L6 21 Z" Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="1.4" Width="14" Height="16" Stretch="Uniform"
                                          StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   MaxWidth="240" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CreatedText}" Style="{StaticResource Caption}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="4"
                                                Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding GameVersionText, Converter={StaticResource TextToVis}}">
                                            <TextBlock Text="{Binding GameVersionText}" FontSize="10"
                                                       Foreground="{DynamicResource TextSubBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="·" Style="{StaticResource Caption}" Margin="7,0" />
                                        <TextBlock Text="{Binding DiffText}" FontSize="11.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDiff}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BtnGhost}" Height="30" Padding="12,0" Content="应用"
                                            Click="Apply_Click" />
                                    <Button Style="{StaticResource BtnSubtle}" Height="30" Padding="8,0" Margin="4,0,0,0"
                                            Content="严格应用" Click="ApplyStrict_Click" ToolTip="方案里没记录的模组也停用" />
                                    <Button Style="{StaticResource BtnDanger}" Height="30" Padding="12,0" Margin="6,0,0,0"
                                            Content="删除" Click="Delete_Click" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProfileCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="还没有保存过方案" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="调好一套启停组合，存下来，之后一键切回去。" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <Button Style="{StaticResource BtnPrimary}" Height="34" Margin="0,14,0,0"
                            Content="保存当前配置" Click="Save_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
