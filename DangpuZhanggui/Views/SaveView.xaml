<UserControl x:Class="Dangpu.Views.SaveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="存档" Style="{StaticResource H1}" />
                <TextBlock Text="游戏存档在 LocalLow 里，这里只抓当前存档和索引，不动其他槽位。换方案、删模组之前先拍一张。"
                           Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource BtnGhost}" Height="34" Click="OpenFolder_Click">
                    <TextBlock Text="打开存档目录" FontSize="12.5" />
                </Button>
                <Button Style="{StaticResource BtnGhost}" Height="34" Margin="8,0,0,0" Click="Refresh_Click">
                    <TextBlock Text="刷新" FontSize="12.5" />
                </Button>
                <Button Style="{StaticResource BtnPrimary}" Height="34" Margin="8,0,0,0" Click="Create_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M4 4 H17 L20 7 V20 H4 Z M8 4 V9 H16 V4 M8 14 H16 V20 H8 Z"
                              Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.4"
                              Width="12" Height="12" Stretch="Uniform" StrokeLineJoin="Round"
                              VerticalAlignment="Center" />
                        <TextBlock Text="拍一张快照" Margin="7,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,13" Margin="0,16,0,10">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding SaveInfoText}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding SaveCountText}" Style="{StaticResource Caption}" />
                        <TextBlock Text="·" Style="{StaticResource Caption}" Margin="8,0" />
                        <TextBlock Text="{Binding SaveFolderText}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="360" ToolTip="{Binding SaveFolderText}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="应用方案前自动快照" Style="{StaticResource Caption}" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ToggleButton Style="{StaticResource Switch}"
                                  IsChecked="{Binding AutoSaveBeforeProfile, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,10">
            <Grid>
                <ListBox Style="{StaticResource BareList}" ItemsSource="{Binding SaveSnapshots}" Padding="4,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" CornerRadius="8" Background="Transparent" Padding="12,11"
                                                Margin="0,0,0,2">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background"
                                                        Value="{DynamicResource SurfaceAltBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="34" Height="34" CornerRadius="8"
                                        Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <Path Data="M4 4 H17 L20 7 V20 H4 Z M8 4 V9 H16 V4 M8 14 H16 V20 H8 Z"
                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" Width="15"
                                          Height="15" Stretch="Uniform" StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CreatedText}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="4" Padding="6,1"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding Label, Converter={StaticResource TextToVis}}">
                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                       Foreground="{DynamicResource TextSubBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding FileListText}" Style="{StaticResource Caption}"
                                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BtnGhost}" Height="30" Padding="12,0" Content="还原"
                                            Click="Restore_Click" />
                                    <Button Style="{StaticResource BtnDanger}" Height="30" Padding="12,0" Margin="6,0,0,0"
                                            Content="删除" Click="Delete_Click" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SaveSnapshotCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="还没有存档快照" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="只抓当前存档和索引，换配置、删模组之前先拍一张。" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <Button Style="{StaticResource BtnPrimary}" Height="34" Margin="0,14,0,0"
                            Content="拍一张快照" Click="Create_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
